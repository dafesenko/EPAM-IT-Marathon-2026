#!/bin/sh
# Conventional Commits for commits that touch the AQA framework: type(scope): subject
git diff --cached --name-only | grep -q '^aqa/restaurant-aqa-framework/' || exit 0

subject=$(head -n 1 "$1")
case "$subject" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'; then
  echo "Commit message must look like: type(scope): subject"
  echo "  types: feat fix docs style refactor perf test build ci chore revert"
  echo "  got:   $subject"
  exit 1
fi
