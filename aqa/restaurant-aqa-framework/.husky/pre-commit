#!/bin/sh
# Format and Gherkin checks on the staged AQA files; commits that do not touch the AQA framework skip it.
git diff --cached --name-only | grep -q '^aqa/restaurant-aqa-framework/' || exit 0
cd "$(git rev-parse --show-toplevel)/aqa/restaurant-aqa-framework" || exit 0
dotnet husky run --group pre-commit --no-partial
